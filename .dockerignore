# Allow only build inputs. Never send local state or credentials as build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!backend/
backend/**
!backend/medialink/
backend/medialink/**
!backend/medialink/*.py
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
# Defense in depth for accidental runtime files below source directories.
**/__pycache__/
**/*.pyc
**/*.pyo
**/node_modules/
**/.venv/
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite*
**/*.session*
**/*.log
**/*.log.*
**/*.pem
**/*.key
**/cookies*.txt
**/cookies*.json
**/credentials*
**/secrets*
**/*-browser/
**/tmdb-images/
**/mikan-images/
**/backups/
