# Docker Compose reads this after you copy it to .env. It contains no passwords.
# Ports bind only to the host loopback interface by default.
MEDIALINK_BIND_IP=127.0.0.1
OPENLIST_BIND_IP=127.0.0.1
EMBY_BIND_IP=127.0.0.1
MEDIALINK_PORT=8766
OPENLIST_PORT=5244
EMBY_PORT=8096
TZ=Etc/UTC

# Official upstream images; pin approved digests here for controlled upgrades.
OPENLIST_IMAGE=openlistteam/openlist:v4.2.6
EMBY_IMAGE=emby/embyserver:latest
NODE_IMAGE=node:24-bookworm-slim
PYTHON_IMAGE=python:3.12-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.13

# No 115 cookies, OpenList tokens or API keys belong in this file.
# Enter them in the application settings after initializing your own password.
